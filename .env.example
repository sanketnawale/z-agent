# Z-Agent Environment Example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env for local developer defaults.
# In session/product mode, users enter credentials on the setup page.
# NEVER commit your real .env file to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ───────────────────────────────────────────────────────────────────
# Set DJANGO_DEBUG=false for any non-local deployment.
DJANGO_DEBUG=false

# Comma-separated list of hosts Django will serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,zagent.cloudnova.tech

# Comma-separated list of trusted CSRF origins (scheme+host).
DJANGO_CSRF_TRUSTED_ORIGINS=https://zagent.cloudnova.tech

# IMPORTANT: replace this with a strong random value for any real deployment.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# ── FastAPI ───────────────────────────────────────────────────────────────────
FASTAPI_URL=http://127.0.0.1:3001

# ── Ollama / AI defaults ──────────────────────────────────────────────────────
# Provider/model used for fresh sessions on the setup page.
DEFAULT_AI_PROVIDER=custom_ollama
DEFAULT_AI_MODEL=llama3.2:3b

# Local development (non-Docker):
OLLAMA_URL=http://127.0.0.1:11434/api/generate

# Docker mode — use the container name as hostname:
# DEFAULT_OLLAMA_URL=http://ollama:11434/api/generate

OLLAMA_MODEL=llama3.2:3b

# ── IBM Z / Zowe CLI ──────────────────────────────────────────────────────────
# Optional developer defaults.
# Leave empty to require user entry on the setup page.
ZOWE_BIN=zowe
ZOWE_HOST=
ZOWE_PORT=10443
ZOWE_USER=
ZOWE_PASSWORD=
ZOWE_REJECT_UNAUTHORIZED=false

# ── Dataset filter ────────────────────────────────────────────────────────────
# Default pattern for the Dataset Explorer.
# Leave as * to list all accessible datasets.
DATASET_FILTER=*

# ── USS home override ─────────────────────────────────────────────────────────
# Leave empty to use dynamic detection: /z/<userid-lowercase>
USS_HOME=

# ── Cloud AI API keys ─────────────────────────────────────────────────────────
# Only required if using Gemini, Claude, or OpenAI provider.
# Leave empty to use Ollama or rule-based mode only.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
